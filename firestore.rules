rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'sultanharis655@gmail.com';
    }

    // Allow read/write for profiles
    match /profiles/{userId} {
      allow read: if true;
      allow write, delete: if isOwner() || (request.auth != null && request.auth.uid == userId);
    }

    // Unsent Messages - Owner can delete or moderate any post
    match /unsent_messages/{messageId} {
      allow read: if resource.data.visibility == 'anonymous' || (request.auth != null && (resource.data.user_id == request.auth.uid || isOwner()));
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if isOwner() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow delete: if isOwner() || (request.auth != null && resource.data.user_id == request.auth.uid);
    }

    // Reactions
    match /reactions/{reactionId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow delete: if isOwner() || (request.auth != null && resource.data.user_id == request.auth.uid);
    }

    // Time Capsules
    match /time_capsules/{capsuleId} {
      allow read: if isOwner() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isOwner() || (request.auth != null && resource.data.user_id == request.auth.uid);
    }

    // AI Analyses
    match /ai_analyses/{analysisId} {
      allow read: if isOwner() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // Reports - Owner can read, review, and delete all reports
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner();
    }

    // Banned Users Collection - Owner can read, ban, and unban any user
    match /banned_users/{userId} {
      allow read: if true;
      allow write, delete: if isOwner();
    }

    // Blocked Users
    match /blocked_users/{blockId} {
      allow create, update: if isOwner() || (request.auth != null && request.resource.data.blocker_id == request.auth.uid);
      allow read, delete: if isOwner() || (request.auth != null && resource.data.blocker_id == request.auth.uid);
    }

    // Feedback & Reviews
    match /feedback_reviews/{reviewId} {
      allow read: if resource.data.is_public == true || (
        request.auth != null && (
          resource.data.user_id == request.auth.uid || 
          isOwner()
        )
      );
      allow create: if true;
      allow update, delete: if isOwner() || (
        request.auth != null && resource.data.user_id == request.auth.uid
      );
    }
  }
}

